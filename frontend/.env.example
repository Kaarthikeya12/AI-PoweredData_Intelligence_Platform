# Copy to .env.local and fill in. Only public, browser-safe values belong here.
# NEVER put the Supabase service-role key in the frontend.

# Supabase project URL (Project Settings → API / Data API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase public key. Use ONE of these:
#   - the legacy "anon" key, or
#   - the newer "publishable" key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# FastAPI backend base URL (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
